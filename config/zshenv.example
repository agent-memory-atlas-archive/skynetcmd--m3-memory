# M3 Memory: shell environment (.zshenv)
# Copy to ~/.zshenv if you use the aliases in zshrc.example. It is sourced by
# Zsh on every shell startup (interactive and non-interactive).

# --- 1. CHECKOUT LOCATION (only for zshrc.example's aliases) ---
# Set this to the absolute path of your m3-memory repository clone. It is used
# only by the aliases in zshrc.example; m3 itself does not read it. Do NOT use
# M3_MEMORY_ROOT for this: that variable relocates all of m3's data.
export M3_CHECKOUT="$HOME/m3-memory"

# --- 2. SETTINGS AND SECRETS DO NOT BELONG HERE ---
# m3 reads its settings from m3_config.toml and its secrets from the secrets
# file that config names (default <config root>/m3_secrets.toml, user-only),
# or from the OS keyring. A shell profile reaches only the shells that source
# it, never m3's background services, and an exported secret is inherited by
# every program the shell starts. So:
#
#   m3 config set sync.warehouse_host <server>     # any setting
#   m3 config show                                  # every setting and its origin
#   m3 secret set AGENT_OS_MASTER_KEY --keyring     # m3 asks for the value
#   m3 secret set M3_CDW_PG_URL                     # likewise for each secret
#   m3 config import-env                            # move old exports into the files
#
# Every key, its default and its old environment name:
# docs/CONFIG_REFERENCE.md and docs/ENVIRONMENT_VARIABLES.md.
