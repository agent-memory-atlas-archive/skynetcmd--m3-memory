# m3-memory Cognitive Loop — Linux systemd --user unit template.
#
# Installed by bin/install_schedules.py, which substitutes [M3_MEMORY_ROOT]
# and [M3_PYTHON] and writes the result to
# ~/.config/systemd/user/m3-cognitive-loop.service, then runs
#   systemctl --user daemon-reload
#   systemctl --user enable --now m3-cognitive-loop.service
#
# NOTE: ExecStart deliberately does NOT pass --background. systemd manages
# the process directly (Type=simple); the loop must run in the foreground or
# the double-fork would detach it from systemd's supervision.
#
# Headless / server boxes where the user is not always logged in may want
#   loginctl enable-linger <user>
# so the service runs without an active login session.

[Unit]
Description=m3-memory Cognitive Loop (autonomous heartbeat)
After=network.target

[Service]
Type=simple
ExecStart=[M3_PYTHON] [M3_MEMORY_ROOT]/bin/m3_cognitive_loop.py --interval 300 --log-file [M3_LOGS_ROOT]/cognitive_loop.log [M3_CONFIG_ARGS]
Restart=always
RestartSec=10
# File-descriptor headroom (defense-in-depth; the real fix is connection-pool
# reuse in the loop). systemd's default (often 1024) let FD growth escalate to
# "Too many open files".
LimitNOFILE=4096
# Exit code 4 = EXIT_ALREADY_RUNNING (another instance already holds the
# single-instance lock). SuccessExitStatus=4 keeps the unit out of "failed";
# RestartPreventExitStatus=4 is what stops Restart=always respawning it (Success
# alone does not: "always" restarts on clean exits too). If the winning instance
# later dies, the loop watchdog (heartbeat) restarts this unit.
SuccessExitStatus=4
RestartPreventExitStatus=4

[Install]
WantedBy=default.target
